{
  "name": "pulse-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time e-commerce business analytics dashboard using Node.js, Express, Socket.IO, MongoDB and React",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/src/index.js",
    "server:start": "node server/src/index.js",
    "client:dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
